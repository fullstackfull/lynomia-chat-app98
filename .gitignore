### Mac OS ###
.DS_Store
# Fonts copied out of `flutter build web`'s asset bundle so golden tests render words rather than boxes.
# Regenerate with: cp build/web/assets/fonts/fallback/Roboto-Regular.ttf build/web/assets/fonts/MaterialIcons-Regular.otf test/visual/
test/visual/*.ttf
test/visual/*.otf

# Flutter's per-configuration build cache: kernel snapshots, .filecache, dependency stamps. These are
# artifacts of whichever machine ran the build, meaningless on any other, and ~50MB per configuration.
# (Two such directories were committed before this rule; it does not untrack them, only stops new ones.)
.dart_tool/flutter_build/

# Golden-test failure output. `flutter test` writes master/test/diff PNGs here on every
# mismatch, including the transient ones during a `--update-goldens` run. They are debugging
# artifacts of one run on one machine, never deliverables.
test/visual/failures/
